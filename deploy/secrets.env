# Pushover keys for the hot tub controller.
#
# Installed as /etc/hottub/secrets.env (root:hottub, mode 640) on the first
# install only. This copy in the repository must stay empty.
#
# To switch notifications on, edit the installed file on the Pi:
#     sudoedit /etc/hottub/secrets.env
# remove the "#" from both lines, put the values after the "=", then
#     sudo systemctl restart hottub
# and press "Send a test notification" on the Settings page.
#
# The token is the API token of the Pushover application you created for
# the hot tub; the user key is on your Pushover dashboard. Set both or
# neither: with only one, the service refuses to start.

#HOTTUB_PUSHOVER_TOKEN=
#HOTTUB_PUSHOVER_USER=
